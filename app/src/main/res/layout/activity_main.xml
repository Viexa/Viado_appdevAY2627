<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#1C1B1F">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="LabCheck - CCIT Lab Readiness"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ENHANCEMENT 1: APPLICATION INFO -->
    <TextView
        android:id="@+id/tvAppInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Application ID: com.example.viado_appdev&#10;Lab Room: CompLab 1"
        android:textColor="#D0BCFF"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LIFECYCLE LOG -->
    <TextView
        android:id="@+id/tvLifecycleLog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="#2B2930"
        android:padding="12dp"
        android:text="Lifecycle trace ready..."
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvAppInfo"
        app:layout_constraintBottom_toTopOf="@id/btnClearLog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CLEAR LOG BUTTON -->
    <Button
        android:id="@+id/btnClearLog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        android:text="Clear Log"
        app:layout_constraintTop_toBottomOf="@id/tvLifecycleLog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSimulateTick"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <!-- CHECK-IN BUTTON -->
    <Button
        android:id="@+id/btnSimulateTick"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Log Check-In Heartbeat"
        app:layout_constraintTop_toTopOf="@id/btnClearLog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnClearLog"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
